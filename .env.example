# ═══════════════════════════════════════════════════════════════
#  SME Metadata Governance Framework — Environment Variables
#  Copy to .env and fill in values before deploying.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────
DB_PASSWORD=SMEGov2026
DATABASE_URL=postgresql://gov_admin:SMEGov2026@postgres:5432/sme_governance

# ── JWT Authentication ────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-64-char-string-before-deploying

# ── Jupyter Lab ───────────────────────────────────────────────
JUPYTER_TOKEN=smegov2026

# ── Application ───────────────────────────────────────────────
ENVIRONMENT=production
ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ── Cloud Deployment (Railway / Render) ───────────────────────
# PORT is set automatically by Railway/Render — do not override
# PORT=8000
